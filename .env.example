# Copy this file to .env.local and fill in values from Supabase project settings.
# These are public browser values; never put service_role keys or payment secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: only for local visual development; does not enable secure admin access.
VITE_DEMO_MODE=false
